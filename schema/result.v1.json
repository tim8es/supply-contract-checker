{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tim8es/supply-contract-checker/blob/main/schema/result.v1.json",
  "title": "Semantic TextNavigator analysis result",
  "type": "object",
  "required": [
    "schemaVersion",
    "asOf",
    "contracts",
    "issues",
    "documentCount"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "documentCount": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "file",
        "line",
        "endLine",
        "quote"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string"
        },
        "valueText": {
          "type": [
            "string",
            "null"
          ],
          "description": "Literal source token selected for the normalized field value."
        },
        "verified": {
          "type": "boolean",
          "description": "True only if source byte-range and value token pass validation; does not certify legal force."
        }
      }
    },
    "field": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "value",
        "evidence",
        "changedBy",
        "effective"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "changedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "proposal": {
      "type": "object",
      "required": [
        "file",
        "kind",
        "amount",
        "deadline"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "draft",
            "letter"
          ]
        },
        "amount": {
          "$ref": "#/$defs/field"
        },
        "deadline": {
          "$ref": "#/$defs/field"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraFields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "id",
        "supplier",
        "amount",
        "deadline",
        "proposals",
        "review",
        "documents",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "supplier": {
          "type": [
            "string",
            "null"
          ]
        },
        "supplierEvidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount": {
          "$ref": "#/$defs/field"
        },
        "deadline": {
          "$ref": "#/$defs/field"
        },
        "source": {
          "type": "string"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposal"
          }
        },
        "history": {
          "type": "object",
          "required": [
            "amount",
            "deadline"
          ],
          "properties": {
            "amount": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/historyEntry"
              }
            },
            "deadline": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/historyEntry"
              }
            }
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/historyEntry"
            }
          }
        },
        "extraFields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          },
          "description": "Optional registered fields, such as penaltyRate in percent per day."
        }
      }
    },
    "historyEntry": {
      "type": "object",
      "required": [
        "value",
        "evidence",
        "file",
        "effective",
        "outcome"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "file": {
          "type": "string"
        },
        "effective": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "enum": [
            "base",
            "applied",
            "unresolved",
            "conflict"
          ]
        }
      }
    }
  }
}
